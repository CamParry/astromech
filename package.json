{
    "name": "astromech-monorepo",
    "private": true,
    "type": "module",
    "author": "Cam",
    "license": "MIT",
    "packageManager": "pnpm@11.17.0",
    "scripts": {
        "dev": "pnpm -F astromech dev",
        "verify": "node scripts/verify.ts",
        "verify:fast": "node scripts/verify.ts --fast",
        "verify:runtime": "node scripts/verify.ts --runtime",
        "verify:status": "node scripts/verify.ts --status",
        "build": "node scripts/turbo.ts --lock build",
        "build:js": "node scripts/turbo.ts --lock --no-dts build",
        "typecheck": "node scripts/turbo.ts --filter='!./apps/*' typecheck && pnpm run typecheck:apps",
        "typecheck:apps": "node scripts/turbo.ts --lock --filter='astromech-demo^...' --filter='astromech-demo-cloudflare^...' build @astromech/admin#routes:generate && pnpm -F astromech-demo typecheck && pnpm -F astromech-demo-cloudflare typecheck",
        "lint": "node scripts/turbo.ts lint",
        "check:config": "pnpm -F astromech-demo check:config && pnpm -F astromech-demo-cloudflare check:config",
        "check:node-imports": "node scripts/check-node-imports.ts",
        "check:exports": "node scripts/check-exports-parity.ts",
        "check:docs": "node scripts/check-docs-links.ts && node scripts/docs-index.ts --check",
        "check:unused": "knip && knip --production --include files,exports,types,nsExports,nsTypes,enumMembers",
        "check:boot": "node scripts/turbo.ts --lock astromech-demo#check:boot",
        "check:boot:cloudflare": "node scripts/turbo.ts --lock astromech-demo-cloudflare#check:boot:cloudflare",
        "check:deployed:cloudflare": "node scripts/check-deployed-cloudflare.ts",
        "check:install": "node scripts/turbo.ts --lock @astromech/scripts#check:install",
        "check:install:pnpm": "node scripts/turbo.ts --lock @astromech/scripts#check:install:pnpm",
        "check:hooks": "node --test \".claude/hooks/*.test.mjs\"",
        "report:drift": "node scripts/report-drift.ts",
        "land": "node scripts/land.ts",
        "prior-art": "node scripts/prior-art.ts",
        "roadmap": "node scripts/docs-index.ts roadmap",
        "decisions": "node scripts/docs-index.ts decisions",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:css": "pnpm -F @astromech/admin lint:css",
        "test:run": "node scripts/turbo.ts --lock test:coverage",
        "db:generate": "pnpm -F astromech-demo db:generate",
        "db:init": "pnpm -F astromech-demo db:init",
        "db:seed:demo": "tsx apps/demo/seed.ts",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.30.0",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@tanstack/eslint-plugin-query": "^5.103.2",
        "eslint": "^10.1.0",
        "eslint-config-turbo": "2.11.7",
        "husky": "^9.1.7",
        "knip": "5.88.1",
        "lint-staged": "^16.4.0",
        "playwright": "^1.62.1",
        "prettier": "3.8.1",
        "prettier-plugin-astro": "0.14.1",
        "stylelint": "^17.6.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-order": "^8.1.1",
        "tsx": "^4.21.0",
        "turbo": "2.11.7",
        "typescript-eslint": "^8.57.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,jsonc,astro,yml,yaml,js,cjs,mjs}": [
            "prettier --write"
        ],
        "*.md": [
            "prettier --write",
            "sh -c 'for f; do case \"$f\" in */roadmap/*|*/decisions/*) node scripts/docs-index.ts && exec git add roadmap/README.md DECISIONS.md;; esac; done' --"
        ],
        ".claude/hooks/**": "sh -c 'node --test \".claude/hooks/*.test.mjs\"'",
        "scripts/**": "sh -c 'cd scripts && node --test'"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
