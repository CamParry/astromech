{
    "name": "astromech-monorepo",
    "private": true,
    "type": "module",
    "author": "Cam",
    "license": "MIT",
    "packageManager": "pnpm@11.17.0",
    "scripts": {
        "dev": "pnpm -F astromech dev",
        "verify": "node scripts/verify.mjs",
        "verify:fast": "node scripts/verify.mjs --fast",
        "build": "pnpm -r -F \"./packages/**\" build",
        "typecheck": "pnpm -r -F \"./packages/**\" typecheck && pnpm -F astromech-demo typecheck && pnpm -F astromech-demo-cloudflare typecheck",
        "lint": "pnpm -F @astromech/schema-engine lint && pnpm -F astromech lint",
        "check:config": "pnpm -F astromech-demo check:config && pnpm -F astromech-demo-cloudflare check:config",
        "check:node-imports": "pnpm -F astromech check:node-imports",
        "check:exports": "pnpm -F astromech check:exports",
        "check:docs": "node scripts/check-docs-links.mjs",
        "check:boot": "node scripts/check-boot.mjs",
        "check:boot:cloudflare": "node scripts/check-boot-cloudflare.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:css": "pnpm -F astromech lint:css",
        "test": "pnpm -F astromech test",
        "test:run": "pnpm -F @astromech/schema-engine test:run && pnpm -F astromech test:run && pnpm -F @astromech/assistant test:run",
        "db:generate": "pnpm -F astromech-demo db:generate",
        "db:init": "pnpm -F astromech-demo db:init",
        "db:seed": "pnpm -F astromech db:seed",
        "db:seed:demo": "tsx apps/demo/seed.ts",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.30.0",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "eslint": "^10.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "playwright": "^1.62.1",
        "prettier": "3.8.1",
        "prettier-plugin-astro": "0.14.1",
        "stylelint": "^17.6.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-order": "^8.1.1",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.57.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,md,astro}": [
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
