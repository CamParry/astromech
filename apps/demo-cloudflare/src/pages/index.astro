---
import { getAstromech } from 'astromech';

let pages: { id: string; fields: Record<string, unknown> }[] = [];
let error: string | null = null;

try {
    const app = await getAstromech();
    const result = await app.entries.query({ type: 'page', limit: 10 });
    pages = result.data;
} catch (err) {
    error = err instanceof Error ? err.message : String(err);
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Astromech on Cloudflare</title>
    </head>
    <body>
        <h1>Astromech on Cloudflare</h1>
        <p>D1 for the database, R2 for media, Cron Triggers for the scheduler.</p>

        {error && <p>Nothing to read yet: {error}</p>}

        <ul>
            {pages.map((page) => <li>{String(page.fields.title)}</li>)}
        </ul>

        <p><a href="/cms">Open the admin</a></p>
    </body>
</html>
