{
    // The Cloudflare demo's boot check and typecheck build or read every
    // package it depends on through `exports`, which point at `dist`, so both
    // wait for those builds (`^build`), and a package's source reaches their
    // hash through its build's. The app's `build` script is no task of its
    // own: the boot check runs it.
    "$schema": "../../node_modules/turbo/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": { "extends": false },
        // `scripts/check-boot-cloudflare.mjs`, which reads the scripts listed
        // here. The `.env` and `.dev.vars` are read by the build and the
        // Worker, and git ignores them.
        "check:boot:cloudflare": {
            "dependsOn": ["^build", "//#routes:generate"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.md",
                ".env",
                ".dev.vars",
                "$TURBO_ROOT$/scripts/check-boot-cloudflare.mjs",
                "$TURBO_ROOT$/scripts/require-fresh-dist.mjs",
                "$TURBO_ROOT$/scripts/lib/**",
                "!$TURBO_ROOT$/scripts/lib/**/*.test.ts",
                "$TURBO_ROOT$/scripts/package.json"
            ],
            "env": ["BETTER_AUTH_SECRET"]
        },
        // After the boot check, because `astro sync` here and `astro build`
        // there write the same `.astro/` files.
        "typecheck": {
            "extends": false,
            "dependsOn": ["^build", "//#routes:generate", "check:boot:cloudflare"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
        }
    }
}
