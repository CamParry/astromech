{
    "name": "astromech-demo-cloudflare",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "wrangler dev",
        "deploy:testing": "node ../../scripts/turbo.ts --lock --filter=\"astromech-demo-cloudflare^...\" build && CLOUDFLARE_ENV=testing pnpm run db:init --allow-remote && CLOUDFLARE_ENV=testing astro build && wrangler deploy --env testing",
        "deploy:testing:captcha": ": \"${CAPTCHA_PROVIDER:?}\" \"${CAPTCHA_SITE_KEY:?}\" && pnpm run deploy:testing --var CAPTCHA_PROVIDER:$CAPTCHA_PROVIDER --var CAPTCHA_SITE_KEY:$CAPTCHA_SITE_KEY",
        "typecheck": "astro sync && tsc --noEmit",
        "check:boot:cloudflare": "node ../../scripts/check-boot-cloudflare.ts",
        "check:config": "tsx astromech.config.ts",
        "db:generate": "tsx --tsconfig ../../packages/astromech/tsconfig.json ../../packages/astromech/src/transport/cli/index.ts db:generate",
        "db:init": "tsx --tsconfig ../../packages/astromech/tsconfig.json ../../packages/astromech/src/transport/cli/index.ts db:init"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.1",
        "@astrojs/react": "^6.0.5",
        "astro": "^7.2.1",
        "astromech": "workspace:*",
        "better-auth": "^1.6.28",
        "kysely": "^0.29.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "wrangler": "^4.125.0"
    }
}
