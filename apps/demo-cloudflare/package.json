{
    "name": "astromech-demo-cloudflare",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "wrangler dev",
        "typecheck": "astro sync && tsc --noEmit",
        "check:config": "tsx astromech.config.ts",
        "db:generate": "tsx --tsconfig ../../packages/astromech/tsconfig.json ../../packages/astromech/src/transport/cli/index.ts db:generate --allow-remote",
        "db:init": "tsx --tsconfig ../../packages/astromech/tsconfig.json ../../packages/astromech/src/transport/cli/index.ts db:init --allow-remote"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.1",
        "@astrojs/react": "^6.0.5",
        "astro": "^7.2.1",
        "astromech": "workspace:*",
        "better-auth": "^1.6.28",
        "kysely": "^0.29.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "wrangler": "^4.125.0"
    }
}
