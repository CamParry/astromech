{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "astromech-demo-cloudflare",
    "main": "src/worker.ts",
    "compatibility_date": "2026-02-14",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./dist/client",
    },
    // A dumb frequent ticker. The real cadence is the runner's due-evaluation,
    // read from the `_astromech_cron` table.
    "triggers": {
        "crons": ["* * * * *"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "astromech-demo",
            // Local emulation keys its SQLite file off `database_name` and
            // never contacts the API, so this placeholder is enough to run
            // `wrangler dev` without a Cloudflare account.
            "database_id": "local-emulation-only",
        },
    ],
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "astromech-demo-media",
        },
    ],
    "env": {
        // The deployed test site on the Paragram account (`AGENTS.md`,
        // "Testing deployment"). An environment inherits no bindings or
        // triggers, so each is declared again. Build and migrate with
        // `CLOUDFLARE_ENV=testing`: `pnpm run deploy:testing` does both.
        "testing": {
            "workers_dev": false,
            "routes": [
                {
                    "pattern": "astromech-testing.paragramagency.com",
                    "custom_domain": true,
                },
            ],
            "vars": {
                "BETTER_AUTH_URL": "https://astromech-testing.paragramagency.com",
            },
            "triggers": {
                "crons": ["* * * * *"],
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "astromech-testing",
                    "database_id": "4aa2aa62-25f2-4784-b461-b117a87d9661",
                    // So `db:init --allow-remote` migrates this database
                    // rather than local emulation.
                    "remote": true,
                },
            ],
            "r2_buckets": [
                {
                    "binding": "MEDIA",
                    "bucket_name": "astromech-testing-media",
                },
            ],
        },
    },
}
