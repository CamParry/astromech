{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "strictNullChecks": true,
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",
        // Sites commonly alias `@/` to their own `src`. The demo does too, so
        // `check:boot` fails if core's `@/` resolution collides with it.
        "paths": { "@/*": ["./src/*"] }
    }
}
