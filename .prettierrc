{
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "printWidth": 90,
    "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-astro"],
    "importOrder": [
        "<TYPES>",
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "^@/",
        "^[.]"
    ],
    "importOrderTypeScriptVersion": "5.9.3",
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ]
}
