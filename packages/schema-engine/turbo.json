{
    // The schema engine sits below core and reads no other package, so its
    // tasks read only its own files, and its tests `scripts/lib/cpu-limits.ts`
    // through its vitest config, and wait for nothing, not even the admin's
    // route generation. The root `turbo.json` has the rest.
    "$schema": "../../node_modules/turbo/schema.json",
    "extends": ["//"],
    "tasks": {
        "typecheck": {
            "dependsOn": [],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
        },
        "lint": {
            "dependsOn": [],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
        },
        "test:coverage": {
            "dependsOn": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.md",
                "$TURBO_ROOT$/scripts/lib/cpu-limits.ts"
            ]
        }
    }
}
