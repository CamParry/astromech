{
    "name": "@astromech/schema-engine",
    "version": "0.1.0",
    "type": "module",
    "description": "Schema-as-state migration engine for SQLite: snapshot in — DDL, diffs, and forward-only Kysely migration files out.",
    "author": "Cam Parry",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CamParry/astromech.git",
        "directory": "packages/schema-engine"
    },
    "homepage": "https://github.com/CamParry/astromech/tree/main/packages/schema-engine#readme",
    "bugs": "https://github.com/CamParry/astromech/issues",
    "keywords": [
        "kysely",
        "sqlite",
        "migrations",
        "schema"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./generate": {
            "types": "./dist/generate.d.ts",
            "default": "./dist/generate.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:js": "ASTROMECH_NO_DTS=1 tsup",
        "typecheck": "tsc -p tsconfig.test.json",
        "lint": "eslint src",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "kysely": "*"
    },
    "devDependencies": {
        "@libsql/client": "^0.17.2",
        "@libsql/kysely-libsql": "^0.4.1",
        "@types/node": "^22.20.1",
        "eslint": "^10.8.1",
        "kysely": "^0.28.14",
        "tsup": "^8.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
