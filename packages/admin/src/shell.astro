---
/**
 * Astromech Admin Shell
 *
 * A bare-bones SSR page that serves as the SPA mount point.
 * All admin UI routing is handled client-side by TanStack Router.
 *
 * Registered at `${basePath}/[...path]` by Astromech's route registration.
 */
import { astroSendsCsp } from 'virtual:astromech/config';
import AdminApp from './main.tsx';

export const prerender = false;

// `data-theme` is the single source of truth for colour. For returning users we
// stamp it from the `am-theme` cookie so the correct theme paints with zero
// flash. First-time visitors have no cookie — the inline script below resolves
// their system preference before paint.
const cookieTheme = Astro.cookies.get('am-theme')?.value;
const initialTheme =
    cookieTheme === 'light' || cookieTheme === 'dark' ? cookieTheme : undefined;

// Rendered as is, so its hash below matches what the browser hashes. No-ops
// when the server already stamped a cookie-driven theme.
const themeScript = `if (!document.documentElement.hasAttribute('data-theme')) {
    document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
}`;

// Astro hashes the scripts it bundles, not an inline one, so with
// `security.csp` set this page adds the script's hash to its own policy.
// `Astro.csp` is read only then: without a policy, a read logs a warning in
// production.
if (astroSendsCsp) {
    const digest = await crypto.subtle.digest(
        'SHA-256',
        new TextEncoder().encode(themeScript)
    );
    const hash = btoa(String.fromCharCode(...new Uint8Array(digest)));
    Astro.csp?.insertScriptHash(`sha256-${hash}`);
}
---

<!doctype html>
<html lang="en" data-theme={initialTheme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>Astromech CMS</title>
        {
            /* First-time visitors have no cookie, so the server left data-theme
            unset: resolve it from the system preference before paint. */
        }
        <script is:inline set:html={themeScript} />
    </head>
    <body>
        <AdminApp client:only="react" />
    </body>
</html>
