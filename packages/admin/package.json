{
    "name": "@astromech/admin",
    "version": "0.1.0",
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "./src/main.tsx",
        "./src/i18n.ts",
        "./src/rendering/register-fields.ts",
        "./src/rendering/cells/register-cells.ts",
        "./src/components/ui/index.ts",
        "./src/components/ui/app.ts",
        "./dist/ui/*.js",
        "./dist/chunk-*.js"
    ],
    "description": "The Astromech admin app and its component kit",
    "author": "Cam Parry",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CamParry/astromech.git",
        "directory": "packages/admin"
    },
    "homepage": "https://github.com/CamParry/astromech/tree/main/packages/admin",
    "bugs": "https://github.com/CamParry/astromech/issues",
    "keywords": [
        "astromech",
        "cms",
        "admin"
    ],
    "exports": {
        "./ui": {
            "types": "./dist/ui/index.d.ts",
            "default": "./dist/ui/index.js"
        },
        "./ui/app": {
            "types": "./dist/ui/app.d.ts",
            "default": "./dist/ui/app.js"
        },
        "./ui/layout": {
            "types": "./dist/ui/layout.d.ts",
            "default": "./dist/ui/layout.js"
        },
        "./ui/fields": {
            "types": "./dist/ui/fields.d.ts",
            "default": "./dist/ui/fields.js"
        },
        "./shell.astro": "./src/shell.astro",
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        }
    },
    "publishConfig": {
        "exports": {
            "./ui": {
                "types": "./dist/ui/index.d.ts",
                "default": "./dist/ui/index.js"
            },
            "./ui/app": {
                "types": "./dist/ui/app.d.ts",
                "default": "./dist/ui/app.js"
            },
            "./ui/layout": {
                "types": "./dist/ui/layout.d.ts",
                "default": "./dist/ui/layout.js"
            },
            "./ui/fields": {
                "types": "./dist/ui/fields.d.ts",
                "default": "./dist/ui/fields.js"
            },
            "./shell.astro": "./src/shell.astro",
            "./vite": {
                "types": "./dist/vite.d.ts",
                "default": "./dist/vite.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup",
        "build:js": "ASTROMECH_NO_DTS=1 tsup",
        "routes:generate": "tsr generate",
        "pretypecheck": "pnpm run routes:generate",
        "typecheck": "tsc -p tsconfig.test.json",
        "lint": "eslint src tests",
        "lint:css": "stylelint \"src/styles/**/*.css\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@base-ui/react": "^1.3.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@tanstack/react-form": "^1.28.5",
        "@tanstack/react-query": "^5.94.5",
        "@tanstack/react-router": "^1.168.1",
        "@tanstack/router-plugin": "^1.167.8",
        "@tiptap/core": "^3.0.0",
        "@tiptap/react": "^3.0.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "i18next": "^25.10.3",
        "lucide-react": "^0.577.0",
        "react-colorful": "^5.6.1",
        "react-i18next": "^16.6.0"
    },
    "peerDependencies": {
        "astromech": "*",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@tanstack/router-cli": "^1.167.21",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-v8": "4.1.10",
        "astro": "^6.0.8",
        "astromech": "workspace:*",
        "eslint": "^10.8.1",
        "happy-dom": "^20.10.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "stylelint": "^17.14.1",
        "tsup": "^8.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
