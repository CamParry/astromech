{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "stripInternal": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"],
            "@tests/*": ["./tests/_support/*"],
            "astromech": ["./src/exports/index.ts"],
            "astromech/fields": ["./src/exports/fields.ts"],
            "astromech/columns": ["./src/exports/columns.ts"],
            "astromech/email": ["./src/exports/email.ts"],
            "astromech/shared": ["./src/exports/shared.ts"],
            "astromech/fetch": ["./src/exports/fetch.ts"],
            "@astromech/schema-engine/generate": ["../schema-engine/src/generate.ts"],
            "@astromech/schema-engine": ["../schema-engine/src/index.ts"],
            "@astromech/admin/vite": ["../admin/src/vite.ts"],
            "@astromech/admin/ui": ["../admin/src/exports/ui.ts"],
            "@astromech/admin/ui/app": ["../admin/src/exports/ui-app.ts"],
            "@astromech/admin/ui/layout": ["../admin/src/exports/ui-layout.ts"],
            "@astromech/admin/ui/fields": ["../admin/src/exports/ui-fields.ts"],
            "@astromech/menus": ["../plugins/menus/src/index.ts"],
            "@astromech/redirects": ["../plugins/redirects/src/index.ts"],
            "@astromech/redirects/tables": ["../plugins/redirects/src/tables/index.ts"],
            "@astromech/backups": ["../plugins/backups/src/index.ts"],
            "@astromech/backups/tables": ["../plugins/backups/src/tables/index.ts"],
            "@astromech/backups/internals": ["../plugins/backups/src/backup.ts"],
            "@astromech/forms": ["../plugins/forms/src/index.ts"]
        }
    },
    "include": ["src/**/*", "../admin/src/virtual-modules.d.ts"],
    "exclude": ["node_modules", "dist"]
}
