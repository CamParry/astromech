{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "../..",
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.test.tsbuildinfo",
        "paths": {
            "@tests/*": ["../../astromech/tests/_support/*"]
        }
    },
    "include": ["src/**/*", "migrations/**/*", "tests/**/*"]
}
