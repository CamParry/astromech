{
    "name": "@astromech/assistant",
    "version": "0.1.0",
    "type": "module",
    "description": "An AI assistant for the Astromech admin.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tables": {
            "types": "./dist/tables.d.ts",
            "default": "./dist/tables.js"
        },
        "./admin/*": "./src/admin/*"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:js": "ASTROMECH_NO_DTS=1 tsup",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "astromech": "*",
        "kysely": "^0.28.14",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.30",
        "ai": "^7.0.52",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "astromech": "workspace:*",
        "kysely": "^0.28.17",
        "react-dom": "^19.2.8",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
