{
    "name": "@astromech/assistant",
    "version": "0.1.0",
    "type": "module",
    "description": "An AI assistant for the Astromech admin.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tables": {
            "types": "./dist/tables.d.ts",
            "default": "./dist/tables.js"
        },
        "./admin/*": "./src/admin/*"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "astromech": "*",
        "react": "^19.0.0"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.30",
        "ai": "^7.0.52",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "astromech": "*"
    }
}
