{
    "name": "@astromech/menus",
    "version": "0.1.0",
    "type": "module",
    "description": "Developer-declared navigation menus for Astromech.",
    "author": "Cam Parry",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CamParry/astromech.git",
        "directory": "packages/plugins/menus"
    },
    "homepage": "https://github.com/CamParry/astromech/tree/main/packages/plugins/menus#readme",
    "bugs": "https://github.com/CamParry/astromech/issues",
    "keywords": [
        "astromech",
        "astromech-plugin",
        "menus"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:js": "ASTROMECH_NO_DTS=1 tsup",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "astromech": "*"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "astromech": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
