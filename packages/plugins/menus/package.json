{
    "name": "@astromech/menus",
    "version": "0.1.0",
    "type": "module",
    "description": "Developer-declared navigation menus for Astromech.",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "astromech": "*"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "astromech": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
