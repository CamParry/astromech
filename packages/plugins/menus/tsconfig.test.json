{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "../..",
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.test.tsbuildinfo",
        "paths": {
            "@/*": ["../../astromech/src/*"],
            "@tests/*": ["../../astromech/tests/_support/*"],
            "astromech": ["../../astromech/src/exports/index.ts"],
            "astromech/fields": ["../../astromech/src/exports/fields.ts"],
            "astromech/columns": ["../../astromech/src/exports/columns.ts"],
            "astromech/email": ["../../astromech/src/exports/email.ts"],
            "astromech/shared": ["../../astromech/src/exports/shared.ts"],
            "astromech/fetch": ["../../astromech/src/exports/fetch.ts"],
            "astromech/ui": ["../../astromech/src/exports/admin/ui.ts"],
            "astromech/ui/app": ["../../astromech/src/exports/admin/ui-app.ts"],
            "@astromech/schema-engine": ["../../schema-engine/src/index.ts"],
            "@astromech/schema-engine/generate": ["../../schema-engine/src/generate.ts"]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "../../astromech/src/virtual-modules.d.ts",
        "../../astromech/src/astro-client.d.ts"
    ]
}
