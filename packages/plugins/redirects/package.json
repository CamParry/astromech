{
    "name": "@astromech/redirects",
    "version": "0.1.0",
    "type": "module",
    "description": "URL redirects as a first-class entry type for Astromech.",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tables": {
            "types": "./dist/tables.d.ts",
            "default": "./dist/tables.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "astromech": "*",
        "kysely": "^0.28.14"
    },
    "devDependencies": {
        "@types/node": "^25.9.5",
        "astromech": "workspace:*",
        "kysely": "^0.28.17",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
