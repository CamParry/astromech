{
    "name": "@astromech/authoring",
    "version": "0.1.0",
    "type": "module",
    "description": "An AI authoring assistant for the Astromech admin.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./admin/*": "./src/admin/*"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "astromech": "*",
        "react": "^19.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.115.0"
    },
    "devDependencies": {
        "astromech": "*"
    }
}
