{
    "name": "@astromech/forms",
    "version": "0.1.0",
    "type": "module",
    "description": "Forms with runtime-composed fields, a public submission API, and spam protection for Astromech.",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "astromech": "*",
        "react": "^19.0.0"
    },
    "dependencies": {
        "@react-email/components": "^1.0.10"
    },
    "devDependencies": {
        "astromech": "*",
        "@types/react": "^19.0.0"
    }
}
