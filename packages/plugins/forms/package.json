{
    "name": "@astromech/forms",
    "version": "0.1.0",
    "type": "module",
    "description": "Forms with runtime-composed fields, a public submission API, and spam protection for Astromech.",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "astromech": "*",
        "kysely": "^0.28.14",
        "react": "^19.0.0"
    },
    "dependencies": {
        "@react-email/components": "^1.0.10"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "astromech": "workspace:*",
        "kysely": "^0.28.17",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
