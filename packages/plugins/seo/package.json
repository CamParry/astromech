{
    "name": "@astromech/seo",
    "version": "0.1.0",
    "type": "module",
    "description": "Search metadata, sitemap and SEO health dashboard for Astromech.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./admin/*": "./src/admin/*",
        "./locales/*": "./src/locales/*"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.94.5",
        "astromech": "*",
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@tanstack/react-query": "^5.101.4",
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.18",
        "astromech": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
