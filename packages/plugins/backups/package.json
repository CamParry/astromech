{
    "name": "@astromech/backups",
    "version": "0.1.0",
    "type": "module",
    "description": "Scheduled and on-demand database backups for Astromech.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tables": {
            "types": "./dist/tables.d.ts",
            "default": "./dist/tables.js"
        },
        "./admin/*": "./src/admin/*",
        "./locales/*": "./src/locales/*"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "migrations",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:js": "ASTROMECH_NO_DTS=1 tsup",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.94.5",
        "astromech": "*",
        "kysely": "^0.28.0",
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@tanstack/react-query": "^5.101.4",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "astromech": "workspace:*",
        "kysely": "^0.28.17",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
