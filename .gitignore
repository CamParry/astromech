.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Mutation testing (Stryker). Its stryker.log is covered by *.log above.
packages/astromech/reports/
packages/astromech/.stryker-tmp/

